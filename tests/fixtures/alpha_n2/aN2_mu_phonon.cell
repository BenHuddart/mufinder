# ----------------------
# --- DFT PARAMETERS ---
# ----------------------

# Pseudopotentials
!%block species_pot
!NCP17                 ! The name of a built-in library C17/C9/C8/C7/MS/HARD/QC5/NCP17/NPC9 ! This is for norm-conserving pseudopotentials (JUST COMMENT OUT THE WHOLE BLOCK FOR ULTRASOFT!)
!%endblock species_pot

# K-points
kpoints_mp_grid 2 2 2

# Use symmetry
symmetry_generate

# ---------------------------
# --- PHYSICAL PARAMETERS ---
# ---------------------------

# Quantisation (magnetisation) axis for spin in fractional coordinates. Supposedly only used/relevant in DFT+U (see https://www.researchgate.net/post/How_can_we_set_the_quantization_axis_in_a_certain_direction_instead_of_the_default_direction_CASTEP)
!quantisation_axis: 0.000000000000000   0.000000000000000   1.000000000000000 ! Along the c axis

# Hubbard parameters for DFT+U. "Hubbard_U" here is actually U-J, where U is the actual Hubbard U and J is the Hund coupling!
!%BLOCK Hubbard_U
!eV # Units
!!Cu d: 5.0
!Cu d: TEMPLATE_HUBBARD_U
!%ENDBLOCK Hubbard_U

# Muon mass ("H:mu" = muon)
%BLOCK species_mass
amu                ! Atomic mass units
H:mu 0.11342892566 ! Muon instead of hydrogen H:mu
%ENDBLOCK species_mass

# Muon gyromagnetic ratio ("H:mu" = muon)
%BLOCK species_gamma
radsectesla
H:mu 851586494.1 ! Muon instead of hydrogen H:mu
%ENDBLOCK species_gamma

# -------------------
# --- CONSTRAINTS ---
# -------------------

# Constrain geometry optimization to use the original symmetry
snap_to_symmetry

# Fix lattice parameters of the unit cell (all)
fix_all_cell true

!# Fix lattice parameters of the unit cell (specific)
!%BLOCK CELL_CONSTRAINTS
!1 2 3  ! [1st line] a, b, c can vary
!1 1 2  ! [1st line] a=b, c can vary
!4 5 6  ! [2nd line] alpha, beta, gamma can vary
!0 0 0  ! [2nd line] Fix alpha, beta, gamma ! To force CASTEP to respect the orthorhombic symmetry of Barlowite even when doing a spin-polarised calculation
!%ENDBLOCK CELL_CONSTRAINTS

# Fix the centre of mass (for MD)
fix_com true

# Fix ion positions (all)
!fix_all_ions true

# Fix ion positions (specific)
!%BLOCK IONIC_CONSTRAINTS
!fix: all unfix: O {1-16}
!fix: H:mu 1                  ! Fix muon position
!%ENDBLOCK IONIC_CONSTRAINTS

# External pressure
%BLOCK EXTERNAL_PRESSURE
GPa                       ! Units optional
0.5 0.0 0.0 ! Isotropic presssure of "0.5" GPa
    0.5 0.0 ! Only upper half of 3x3 matrix specified
        0.5 ! CASTEP makes symetric lower half
%ENDBLOCK EXTERNAL_PRESSURE

