%BLOCK PHONON_KPOINT_LIST  
    0.0   0.0   0.0    1.0        ! Wavevector of phonon(s) to compute ( qx qy qz, weight) ! gamma-point 
%ENDBLOCK PHONON_KPOINT_LIST 

# Phonon k-points (normal, grid)
!phonon_kpoint_mp_grid        3 3 3
!phonon_kpoint_mp_offset     0 0 0

# Phonon k-points (supercell, grid)
!supercell_kpoint_mp_grid   2    2    2
!supercell_kpoint_mp_offset 0.25 0.25 0.25

