!%BLOCK POSITIONS_FRAC
!# Muon
!!   H:mu           TEMPLATE_MUON_XYZ                                                       ! Muon
!# POSITIONS_FRAC from "CHG+1-SUPER222-PRECISE2_1200eV-SEDC_TS_POS"
!##INCLUDE<CHG+1-SUPER222-PRECISE2_1200eV-SEDC_TS_POS>
